# 한국투자증권 KIS Open API 설정
# https://apiportal.koreainvestment.com 에서 발급

# API 앱 키 (모의투자 또는 실전투자)
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here

# 계좌번호 (앞 8자리-뒤 2자리)
KIS_ACCOUNT_NUMBER=12345678
KIS_ACCOUNT_PRODUCT_CODE=01

# 환경 설정: real (실전) 또는 paper (모의)
KIS_ENV=paper

# 매매 설정
# 1회 최대 매수 금액 (원)
MAX_BUY_AMOUNT=500000
# 최대 보유 종목 수
MAX_POSITIONS=3
# 목표 수익률 (%)
TAKE_PROFIT_RATE=1.5
# 손절 비율 (%)
STOP_LOSS_RATE=0.7
# 매매 대상 ETF 종목코드 (쉼표 구분)
ETF_SYMBOLS=069500,114800,122630,252670,233740,251340
