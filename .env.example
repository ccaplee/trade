# 한국투자증권 KIS Open API 인증 정보
# 실전 or 모의 여부에 따라 APP_KEY / APP_SECRET 을 각각 발급받아 입력하세요.

# ── 공통 ──────────────────────────────────────────────
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_ACCOUNT_NO=12345678          # 계좌번호 앞 8자리
KIS_ACCOUNT_PRODUCT=01           # 상품코드 (일반 위탁: 01)

# ── 환경 선택 ──────────────────────────────────────────
# "real" → 실전투자,  "paper" → 모의투자
KIS_ENV=paper
