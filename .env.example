# 한국투자증권 KIS Open API 설정
# 실제 값으로 변경 후 .env 로 복사하여 사용하세요

# API 인증 정보 (https://apiportal.koreainvestment.com 에서 발급)
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here

# 계좌 정보
KIS_ACCOUNT_NO=12345678       # 계좌번호 앞 8자리
KIS_ACCOUNT_PRODUCT_CODE=01   # 계좌상품코드 (보통 01)

# 운영 환경 설정
# real: 실전투자, paper: 모의투자
KIS_MODE=paper

# 매매 설정
MAX_POSITION_AMOUNT=500000    # 종목당 최대 매수 금액 (원)
MAX_POSITIONS=5               # 최대 동시 보유 종목 수
TARGET_PROFIT_RATE=0.015      # 목표 수익률 (1.5%)
STOP_LOSS_RATE=0.007          # 손절 비율 (0.7%)

# 로그 설정
LOG_LEVEL=INFO
LOG_FILE=logs/trader.log
