# 한국투자증권 KIS Open API 설정
# 실제 사용 시 아래 값을 본인 계정 정보로 변경하세요.

APP_KEY=your_app_key_here
APP_SECRET=your_app_secret_here
CANO=your_account_number_here        # 계좌번호 8자리
ACNT_PRDT_CD=01                      # 계좌상품코드
IS_REAL=false                        # true: 실전투자, false: 모의투자

# 매매 설정
MAX_POSITIONS=5                      # 최대 동시 보유 종목 수
BUY_AMOUNT=100000                    # 종목당 매수 금액 (원)
TAKE_PROFIT_PCT=1.5                  # 익절 기준 (%)
STOP_LOSS_PCT=0.8                    # 손절 기준 (%)
